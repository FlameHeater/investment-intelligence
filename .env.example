# ── Auth (single-user gate) ────────────────────────────────────────────────
# Password untuk masuk ke aplikasi. WAJIB diisi.
APP_PASSWORD="ganti-dengan-password-anda"
# Rahasia untuk menandatangani cookie sesi. Isi dengan string acak panjang.
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── LLM (opsional; tanpa ini fitur AI mati dengan graceful degradation) ─────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ── Data providers ─────────────────────────────────────────────────────────
# Yahoo Finance chart endpoint (harga US/IDX/GLD) & CoinGecko public API (kripto)
# TIDAK butuh API key — aplikasi jalan tanpa mengisi apa pun di bawah ini.
#
# Finnhub (opsional): fundamental & berita saham AS. Free tier 60 calls/menit.
FINNHUB_API_KEY=""
# Alpha Vantage (opsional): fallback fundamental saham AS. Free tier 5 calls/menit.
ALPHAVANTAGE_API_KEY=""
# Marketaux (opsional): berita multi-aset. Free tier 100 request/hari.
MARKETAUX_API_KEY=""
# CoinGecko Demo key (opsional): menaikkan limit dari ~10 ke 30 calls/menit.
COINGECKO_API_KEY=""
