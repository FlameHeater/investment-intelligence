# ── Auth (single-user gate) ────────────────────────────────────────────────
# Password untuk masuk ke aplikasi. WAJIB diisi.
APP_PASSWORD="ganti-dengan-password-anda"
# Rahasia untuk menandatangani cookie sesi. Isi dengan string acak panjang.
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── LLM (opsional; tanpa ini fitur AI mati dengan graceful degradation) ─────
# Anthropic diprioritaskan kalau ANTHROPIC_API_KEY diisi (berbayar, kualitas
# tertinggi). Kalau kosong tapi GEMINI_API_KEY diisi, aplikasi otomatis jatuh
# ke Gemini (tier gratis Google, cukup untuk pemakaian single-user — lihat
# README bagian "Di mana AI dipakai"). Isi salah satu saja.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# ── Data providers ─────────────────────────────────────────────────────────
# Yahoo Finance chart endpoint (harga US/IDX/GLD) & CoinGecko public API (kripto)
# TIDAK butuh API key — aplikasi jalan tanpa mengisi apa pun di bawah ini.
#
# Finnhub (opsional): fundamental & berita saham AS. Free tier 60 calls/menit.
FINNHUB_API_KEY=""
# Alpha Vantage (opsional): fallback fundamental saham AS. Free tier 5 calls/menit.
ALPHAVANTAGE_API_KEY=""

# ── Fundamental saham IDX (opsional, MATI secara default) ──────────────────
# Mengambil PER/PBV/ROE/margin emiten IDX dari halaman publik Pluang. Ini satu-
# satunya sumber gratis yang menutup celah PRD §4, TAPI Pluang adalah platform
# komersial yang kemungkinan melisensikan datanya dari penyedia hulu.
#
# robots.txt mereka mengizinkan jalur yang dipakai, tapi robots.txt mengatur
# perayapan untuk pengindeksan — bukan penggunaan ulang datanya di produk lain.
# Untuk alat pribadi single-user itu keputusan Anda; kalau aplikasi ini dibagikan
# atau dimonetisasi, PRD §12 mensyaratkan tinjauan hukum lebih dulu.
#
# Alternatif berlisensi: Sectors.app (berbayar).
ENABLE_PLUANG_SCRAPE="false"
# CoinGecko Demo key (opsional): menaikkan limit dari ~10 ke 30 calls/menit.
COINGECKO_API_KEY=""

# ── Refresh terjadwal (opsional) ───────────────────────────────────────────
# Tombol "Perbarui data" di UI berjalan tanpa konfigurasi apa pun, termasuk di
# Vercel. Variabel di bawah hanya untuk refresh TERJADWAL lewat Vercel Cron.
CRON_SECRET=""
